generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Question {
  id           Int      @id @default(autoincrement())
  title        String
  difficulty   String
  statement    String
  example      Json
  constraints  Json
  hints        Json
  starterCode  String
  solution     String
  createdAt    DateTime @default(now())
}