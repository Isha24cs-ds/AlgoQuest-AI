generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Question {
  id Int @id @default(autoincrement())

  title String
  slug  String @unique

  topic      String
  difficulty String

  statement String @db.Text

  example     Json
  constraints Json
  hints       Json

  starterCode Json
  solution    Json

  tags      Json
  companies Json

  acceptance Float
  points     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
